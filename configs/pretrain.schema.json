{
  "$defs": {
    "Architecture": {
      "additionalProperties": false,
      "properties": {
        "peft": {
          "$ref": "#/$defs/PEFT"
        },
        "backend": {
          "default": "native",
          "enum": [
            "native",
            "huggingface"
          ],
          "title": "Backend",
          "type": "string"
        },
        "pretrained_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pretrained Path"
        },
        "pretrained_config_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pretrained Config Sha256"
        },
        "quantization": {
          "default": "none",
          "enum": [
            "none",
            "fp4_fake",
            "nvfp4"
          ],
          "title": "Quantization",
          "type": "string"
        },
        "attention_kernel": {
          "default": "auto",
          "enum": [
            "auto",
            "math",
            "flash",
            "efficient",
            "cudnn"
          ],
          "title": "Attention Kernel",
          "type": "string"
        },
        "custom_swiglu_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Swiglu Path"
        },
        "type": {
          "default": "decoder_rope",
          "enum": [
            "decoder_rope",
            "decoder_moe"
          ],
          "title": "Type",
          "type": "string"
        },
        "num_experts": {
          "default": 4,
          "minimum": 2,
          "title": "Num Experts",
          "type": "integer"
        },
        "experts_per_token": {
          "default": 2,
          "minimum": 1,
          "title": "Experts Per Token",
          "type": "integer"
        },
        "router_aux_loss_coef": {
          "default": 0.01,
          "minimum": 0,
          "title": "Router Aux Loss Coef",
          "type": "number"
        },
        "layers": {
          "default": 6,
          "maximum": 48,
          "minimum": 1,
          "title": "Layers",
          "type": "integer"
        },
        "hidden_size": {
          "default": 512,
          "exclusiveMinimum": 0,
          "title": "Hidden Size",
          "type": "integer"
        },
        "attention_heads": {
          "default": 8,
          "exclusiveMinimum": 0,
          "title": "Attention Heads",
          "type": "integer"
        },
        "kv_heads": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Kv Heads",
          "type": "integer"
        },
        "intermediate_size": {
          "default": 1360,
          "exclusiveMinimum": 0,
          "title": "Intermediate Size",
          "type": "integer"
        },
        "context_length": {
          "default": 128,
          "minimum": 8,
          "title": "Context Length",
          "type": "integer"
        },
        "norm": {
          "const": "rmsnorm",
          "default": "rmsnorm",
          "title": "Norm",
          "type": "string"
        },
        "norm_eps": {
          "default": 1e-05,
          "exclusiveMinimum": 0,
          "title": "Norm Eps",
          "type": "number"
        },
        "activation": {
          "const": "swiglu",
          "default": "swiglu",
          "title": "Activation",
          "type": "string"
        },
        "rope_theta": {
          "default": 10000,
          "exclusiveMinimum": 0,
          "title": "Rope Theta",
          "type": "number"
        },
        "attention_dropout": {
          "default": 0,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Attention Dropout",
          "type": "number"
        },
        "residual_dropout": {
          "default": 0,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Residual Dropout",
          "type": "number"
        },
        "bias": {
          "default": false,
          "title": "Bias",
          "type": "boolean"
        },
        "tie_embeddings": {
          "default": true,
          "title": "Tie Embeddings",
          "type": "boolean"
        },
        "init_std": {
          "default": 0.02,
          "exclusiveMinimum": 0,
          "title": "Init Std",
          "type": "number"
        },
        "gradient_checkpointing": {
          "default": false,
          "title": "Gradient Checkpointing",
          "type": "boolean"
        }
      },
      "title": "Architecture",
      "type": "object"
    },
    "Data": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "default": "hf_rows",
          "enum": [
            "hf_rows",
            "hf_parquet",
            "local_jsonl"
          ],
          "title": "Provider",
          "type": "string"
        },
        "dataset": {
          "default": "HuggingFaceFW/fineweb-edu",
          "title": "Dataset",
          "type": "string"
        },
        "subset": {
          "default": "sample-10BT",
          "title": "Subset",
          "type": "string"
        },
        "split": {
          "default": "train",
          "title": "Split",
          "type": "string"
        },
        "text_field": {
          "default": "text",
          "title": "Text Field",
          "type": "string"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Path"
        },
        "local_paths": {
          "items": {
            "type": "string"
          },
          "title": "Local Paths",
          "type": "array"
        },
        "storage": {
          "default": "memory",
          "enum": [
            "memory",
            "disk"
          ],
          "title": "Storage",
          "type": "string"
        },
        "max_record_bytes": {
          "default": 4000000,
          "exclusiveMinimum": 0,
          "title": "Max Record Bytes",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "max_documents": {
          "default": 256,
          "minimum": 3,
          "title": "Max Documents",
          "type": "integer"
        },
        "page_size": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "max_download_bytes": {
          "default": 16000000,
          "exclusiveMinimum": 0,
          "title": "Max Download Bytes",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 30,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "max_tokens": {
          "default": 200000,
          "exclusiveMinimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "domain": {
          "default": "general",
          "title": "Domain",
          "type": "string"
        },
        "domain_keywords": {
          "items": {
            "type": "string"
          },
          "title": "Domain Keywords",
          "type": "array"
        }
      },
      "title": "Data",
      "type": "object"
    },
    "Evaluation": {
      "additionalProperties": false,
      "properties": {
        "benchmark": {
          "default": "auto",
          "enum": [
            "auto",
            "none",
            "hellaswag",
            "financial_phrasebank"
          ],
          "title": "Benchmark",
          "type": "string"
        },
        "benchmark_examples": {
          "default": 8,
          "maximum": 100,
          "minimum": 1,
          "title": "Benchmark Examples",
          "type": "integer"
        },
        "benchmark_max_download_bytes": {
          "default": 2000000,
          "exclusiveMinimum": 0,
          "title": "Benchmark Max Download Bytes",
          "type": "integer"
        },
        "batches": {
          "default": 4,
          "exclusiveMinimum": 0,
          "title": "Batches",
          "type": "integer"
        },
        "prompt": {
          "default": "Education helps people",
          "title": "Prompt",
          "type": "string"
        },
        "generate_tokens": {
          "default": 24,
          "minimum": 1,
          "title": "Generate Tokens",
          "type": "integer"
        },
        "temperature": {
          "default": 0.8,
          "exclusiveMinimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "top_k": {
          "default": 30,
          "minimum": 0,
          "title": "Top K",
          "type": "integer"
        }
      },
      "title": "Evaluation",
      "type": "object"
    },
    "PEFT": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "default": "none",
          "enum": [
            "none",
            "lora",
            "qlora"
          ],
          "title": "Method",
          "type": "string"
        },
        "rank": {
          "default": 8,
          "exclusiveMinimum": 0,
          "title": "Rank",
          "type": "integer"
        },
        "alpha": {
          "default": 16,
          "exclusiveMinimum": 0,
          "title": "Alpha",
          "type": "integer"
        },
        "dropout": {
          "default": 0,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Dropout",
          "type": "number"
        },
        "target_modules": {
          "items": {
            "type": "string"
          },
          "title": "Target Modules",
          "type": "array"
        },
        "use_rslora": {
          "default": false,
          "title": "Use Rslora",
          "type": "boolean"
        },
        "compute_dtype": {
          "default": "bf16",
          "enum": [
            "bf16",
            "fp16"
          ],
          "title": "Compute Dtype",
          "type": "string"
        },
        "double_quant": {
          "default": true,
          "title": "Double Quant",
          "type": "boolean"
        }
      },
      "title": "PEFT",
      "type": "object"
    },
    "Processing": {
      "additionalProperties": false,
      "properties": {
        "unicode_normalization": {
          "default": "NFKC",
          "enum": [
            "NFC",
            "NFKC"
          ],
          "title": "Unicode Normalization",
          "type": "string"
        },
        "strip_html": {
          "default": true,
          "title": "Strip Html",
          "type": "boolean"
        },
        "min_chars": {
          "default": 200,
          "exclusiveMinimum": 0,
          "title": "Min Chars",
          "type": "integer"
        },
        "max_chars": {
          "default": 20000,
          "exclusiveMinimum": 0,
          "title": "Max Chars",
          "type": "integer"
        },
        "min_alnum_fraction": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Alnum Fraction",
          "type": "number"
        },
        "max_repeated_line_fraction": {
          "default": 0.4,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Repeated Line Fraction",
          "type": "number"
        },
        "exact_dedup": {
          "default": true,
          "title": "Exact Dedup",
          "type": "boolean"
        },
        "near_dedup": {
          "default": true,
          "title": "Near Dedup",
          "type": "boolean"
        },
        "near_dedup_jaccard": {
          "default": 0.9,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Near Dedup Jaccard",
          "type": "number"
        },
        "dedup_ngram_words": {
          "default": 5,
          "exclusiveMinimum": 0,
          "title": "Dedup Ngram Words",
          "type": "integer"
        },
        "pii": {
          "default": "redact",
          "enum": [
            "redact",
            "drop",
            "off"
          ],
          "title": "Pii",
          "type": "string"
        },
        "benchmark_files": {
          "items": {
            "type": "string"
          },
          "title": "Benchmark Files",
          "type": "array"
        },
        "decontamination_ngram_words": {
          "default": 13,
          "exclusiveMinimum": 0,
          "title": "Decontamination Ngram Words",
          "type": "integer"
        },
        "validation_fraction": {
          "default": 0.1,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Validation Fraction",
          "type": "number"
        },
        "test_fraction": {
          "default": 0.1,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Test Fraction",
          "type": "number"
        }
      },
      "title": "Processing",
      "type": "object"
    },
    "Stage": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "pretrain",
          "enum": [
            "pretrain",
            "midtrain",
            "sft",
            "dpo",
            "rlvr",
            "distill"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parent_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Run"
        },
        "teacher_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Teacher Run"
        },
        "distillation_temperature": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Distillation Temperature",
          "type": "number"
        },
        "distillation_alpha": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Distillation Alpha",
          "type": "number"
        },
        "dpo_beta": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "title": "Dpo Beta",
          "type": "number"
        },
        "reward": {
          "default": "integer",
          "enum": [
            "exact_match",
            "integer"
          ],
          "title": "Reward",
          "type": "string"
        },
        "group_size": {
          "default": 4,
          "maximum": 32,
          "minimum": 2,
          "title": "Group Size",
          "type": "integer"
        },
        "rollout_tokens": {
          "default": 16,
          "minimum": 1,
          "title": "Rollout Tokens",
          "type": "integer"
        },
        "kl_coefficient": {
          "default": 0.02,
          "minimum": 0,
          "title": "Kl Coefficient",
          "type": "number"
        },
        "clip_ratio": {
          "default": 0.2,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Clip Ratio",
          "type": "number"
        },
        "reasoning_format": {
          "default": "plain",
          "enum": [
            "plain",
            "think_answer"
          ],
          "title": "Reasoning Format",
          "type": "string"
        }
      },
      "title": "Stage",
      "type": "object"
    },
    "Tokenization": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "default": "byte_bpe",
          "enum": [
            "byte_bpe",
            "pretrained"
          ],
          "title": "Algorithm",
          "type": "string"
        },
        "vocab_size": {
          "default": 4096,
          "maximum": 262144,
          "minimum": 260,
          "title": "Vocab Size",
          "type": "integer"
        },
        "min_frequency": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Min Frequency",
          "type": "integer"
        },
        "special_tokens": {
          "default": [
            "<pad>",
            "<unk>",
            "<bos>",
            "<eos>"
          ],
          "items": {
            "type": "string"
          },
          "title": "Special Tokens",
          "type": "array"
        },
        "add_bos": {
          "default": false,
          "title": "Add Bos",
          "type": "boolean"
        },
        "append_eos": {
          "default": true,
          "title": "Append Eos",
          "type": "boolean"
        }
      },
      "title": "Tokenization",
      "type": "object"
    },
    "Training": {
      "additionalProperties": false,
      "properties": {
        "distributed": {
          "default": "none",
          "enum": [
            "none",
            "ddp"
          ],
          "title": "Distributed",
          "type": "string"
        },
        "distributed_timeout_seconds": {
          "default": 300,
          "exclusiveMinimum": 0,
          "title": "Distributed Timeout Seconds",
          "type": "integer"
        },
        "compile": {
          "default": false,
          "title": "Compile",
          "type": "boolean"
        },
        "compile_backend": {
          "default": "inductor",
          "enum": [
            "inductor",
            "aot_eager",
            "eager"
          ],
          "title": "Compile Backend",
          "type": "string"
        },
        "compile_mode": {
          "default": "default",
          "enum": [
            "default",
            "reduce-overhead",
            "max-autotune"
          ],
          "title": "Compile Mode",
          "type": "string"
        },
        "allow_tf32": {
          "default": false,
          "title": "Allow Tf32",
          "type": "boolean"
        },
        "optimizer_kernel": {
          "default": "default",
          "enum": [
            "default",
            "fused",
            "foreach"
          ],
          "title": "Optimizer Kernel",
          "type": "string"
        },
        "accelerator": {
          "default": "auto",
          "enum": [
            "auto",
            "cpu",
            "cuda",
            "rocm",
            "mps"
          ],
          "title": "Accelerator",
          "type": "string"
        },
        "precision": {
          "default": "auto",
          "enum": [
            "auto",
            "fp32",
            "bf16",
            "fp16"
          ],
          "title": "Precision",
          "type": "string"
        },
        "seed": {
          "default": 42,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "deterministic": {
          "default": true,
          "title": "Deterministic",
          "type": "boolean"
        },
        "steps": {
          "default": 40,
          "exclusiveMinimum": 0,
          "title": "Steps",
          "type": "integer"
        },
        "micro_batch_size": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Micro Batch Size",
          "type": "integer"
        },
        "gradient_accumulation": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Gradient Accumulation",
          "type": "integer"
        },
        "optimizer": {
          "const": "adamw",
          "default": "adamw",
          "title": "Optimizer",
          "type": "string"
        },
        "learning_rate": {
          "default": 0.0005,
          "exclusiveMinimum": 0,
          "title": "Learning Rate",
          "type": "number"
        },
        "min_learning_rate_ratio": {
          "default": 0.1,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Learning Rate Ratio",
          "type": "number"
        },
        "betas": {
          "default": [
            0.9,
            0.95
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Betas",
          "type": "array"
        },
        "weight_decay": {
          "default": 0.1,
          "minimum": 0,
          "title": "Weight Decay",
          "type": "number"
        },
        "optimizer_eps": {
          "default": 1e-08,
          "exclusiveMinimum": 0,
          "title": "Optimizer Eps",
          "type": "number"
        },
        "schedule": {
          "default": "cosine",
          "enum": [
            "cosine",
            "constant"
          ],
          "title": "Schedule",
          "type": "string"
        },
        "warmup_steps": {
          "default": 4,
          "minimum": 0,
          "title": "Warmup Steps",
          "type": "integer"
        },
        "gradient_clip_norm": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Gradient Clip Norm",
          "type": "number"
        },
        "checkpoint_every": {
          "default": 20,
          "exclusiveMinimum": 0,
          "title": "Checkpoint Every",
          "type": "integer"
        },
        "evaluate_every": {
          "default": 10,
          "exclusiveMinimum": 0,
          "title": "Evaluate Every",
          "type": "integer"
        },
        "log_every": {
          "default": 5,
          "exclusiveMinimum": 0,
          "title": "Log Every",
          "type": "integer"
        },
        "max_runtime_seconds": {
          "default": 600,
          "exclusiveMinimum": 0,
          "title": "Max Runtime Seconds",
          "type": "integer"
        }
      },
      "title": "Training",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "name": {
      "default": "first-local",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "title": "Name",
      "type": "string"
    },
    "output_dir": {
      "default": "artifacts/training",
      "title": "Output Dir",
      "type": "string"
    },
    "explain": {
      "default": "detailed",
      "enum": [
        "detailed",
        "brief"
      ],
      "title": "Explain",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/Data"
    },
    "processing": {
      "$ref": "#/$defs/Processing"
    },
    "tokenizer": {
      "$ref": "#/$defs/Tokenization"
    },
    "model": {
      "$ref": "#/$defs/Architecture"
    },
    "training": {
      "$ref": "#/$defs/Training"
    },
    "evaluation": {
      "$ref": "#/$defs/Evaluation"
    },
    "stage": {
      "$ref": "#/$defs/Stage"
    }
  },
  "title": "RunConfig",
  "type": "object"
}
